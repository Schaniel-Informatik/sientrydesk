<Project Sdk="Microsoft.NET.Sdk">

  <!-- Tray-App pro Benutzersitzung. Kennt keine Tokens, spricht nur mit dem lokalen Dienst. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>SIEntryDesk.App</RootNamespace>
    <AssemblyName>SIEntryDesk</AssemblyName>
    <ApplicationIcon>Assets\SIEntryDesk.ico</ApplicationIcon>
    <!-- LibVLC nur für x64, ohne Lua-Skripte (nicht benötigt). -->
    <VlcWindowsX86Enabled>false</VlcWindowsX86Enabled>
    <VlcWindowsArm64Enabled>false</VlcWindowsArm64Enabled>
  </PropertyGroup>

  <ItemGroup>
    <VlcWindowsX64ExcludeFiles Include="lua\%2A%2A" />
  </ItemGroup>

  <!-- WinForms nur für das Tray-Symbol, sonst gibt es Namenskonflikte mit WPF. -->
  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SIEntryDesk.Core\SIEntryDesk.Core.csproj" />
    <ProjectReference Include="..\SIEntryDesk.Audio\SIEntryDesk.Audio.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="LibVLCSharp.WPF" Version="3.10.1" />
    <PackageReference Include="VideoLAN.LibVLC.Windows" Version="3.0.24" />
    <!-- Mikrofon fürs Gegensprechen (WASAPI), MIT. -->
    <PackageReference Include="NAudio.Wasapi" Version="3.1.0" />
  </ItemGroup>

</Project>
