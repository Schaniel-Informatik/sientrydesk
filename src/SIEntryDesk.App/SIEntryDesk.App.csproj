<Project Sdk="Microsoft.NET.Sdk">

  <!-- Tray app per user session. Knows no tokens, talks only to the local service. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>SIEntryDesk.App</RootNamespace>
    <AssemblyName>SIEntryDesk</AssemblyName>
    <ApplicationIcon>Assets\SIEntryDesk.ico</ApplicationIcon>
    <!-- LibVLC for x64 only. -->
    <VlcWindowsX86Enabled>false</VlcWindowsX86Enabled>
    <VlcWindowsArm64Enabled>false</VlcWindowsArm64Enabled>
  </PropertyGroup>

  <!-- Only the LibVLC plugins the live view needs (RTSP via the service, H.264/H.265, AAC/Opus, video and audio
       output on Windows). All under LGPL like LibVLC, checked against the 3.0.x source, see THIRD-PARTY-NOTICES.md.
       If one is missing, the app's vlc.log says "no … module matched". -->
  <ItemGroup>
    <VlcWindowsX64IncludeFiles Include="libvlc.dll;libvlccore.dll" />
    <VlcWindowsX64IncludeFiles Include="plugins\access\liblive555_plugin.dll" />
    <VlcWindowsX64IncludeFiles Include="plugins\codec\libavcodec_plugin.dll;plugins\codec\libopus_plugin.dll;plugins\codec\libd3d11va_plugin.dll;plugins\codec\libdxva2_plugin.dll" />
    <VlcWindowsX64IncludeFiles Include="plugins\demux\libes_plugin.dll" />
    <VlcWindowsX64IncludeFiles Include="plugins\packetizer\libpacketizer_h264_plugin.dll;plugins\packetizer\libpacketizer_hevc_plugin.dll;plugins\packetizer\libpacketizer_mpeg4audio_plugin.dll;plugins\packetizer\libpacketizer_copy_plugin.dll" />
    <VlcWindowsX64IncludeFiles Include="plugins\audio_output\libmmdevice_plugin.dll;plugins\audio_output\libwasapi_plugin.dll;plugins\audio_output\libdirectsound_plugin.dll" />
    <VlcWindowsX64IncludeFiles Include="plugins\video_output\libdirect3d11_plugin.dll;plugins\video_output\libdirect3d9_plugin.dll;plugins\video_output\libdrawable_plugin.dll;plugins\video_output\libwingdi_plugin.dll" />
    <VlcWindowsX64IncludeFiles Include="plugins\d3d11\%2A%2A;plugins\d3d9\%2A%2A;plugins\video_chroma\%2A%2A;plugins\audio_mixer\%2A%2A" />
    <VlcWindowsX64IncludeFiles Include="plugins\audio_filter\libspeex_resampler_plugin.dll;plugins\audio_filter\libugly_resampler_plugin.dll;plugins\audio_filter\libtrivial_channel_mixer_plugin.dll;plugins\audio_filter\libsimple_channel_mixer_plugin.dll;plugins\audio_filter\libaudio_format_plugin.dll" />
  </ItemGroup>

  <!-- WinForms only for the tray icon, otherwise there are name conflicts with WPF. -->
  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SIEntryDesk.Core\SIEntryDesk.Core.csproj" />
    <ProjectReference Include="..\SIEntryDesk.Audio\SIEntryDesk.Audio.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="LibVLCSharp.WPF" Version="3.10.1" />
    <PackageReference Include="VideoLAN.LibVLC.Windows" Version="3.0.24" />
    <!-- Microphone for talkback (WASAPI), MIT. -->
    <PackageReference Include="NAudio.Wasapi" Version="3.1.0" />
    <!-- Service state for the check, MIT. -->
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="10.0.12" />
  </ItemGroup>

</Project>
