<Window x:Class="SIEntryDesk.App.SetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SI EntryDesk"
        Width="900" Height="920" MinWidth="760" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI" FontSize="14">
    <Window.Resources>
        <Style x:Key="Heading" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,22,0,6" />
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#666666" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
        <Style x:Key="Result" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,8,0,0" />
            <Setter Property="FontFamily" Value="Consolas, Segoe UI" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="14,5" />
            <Setter Property="Margin" Value="8,0,0,0" />
        </Style>
    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28,12,28,28">
            <!-- Texts are set in the code (ApplyTexts), in the language of Windows: German or English. -->
            <TextBlock x:Name="Heading" FontSize="26" FontWeight="SemiBold" />
            <TextBlock x:Name="Intro" Style="{StaticResource Hint}" />
            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                <Button x:Name="LoadInstalledButton" Margin="0" Click="OnLoadInstalled" />
                <Button x:Name="OpenConfigButton" Click="OnOpenConfig" />
            </StackPanel>
            <TextBlock x:Name="LoadResult" Style="{StaticResource Result}" />

            <TextBlock x:Name="HostHeading" Style="{StaticResource Heading}" />
            <TextBlock x:Name="HostHint" Style="{StaticResource Hint}" />
            <DockPanel>
                <Button x:Name="HostCheck" DockPanel.Dock="Right" Click="OnCheckHost" />
                <TextBox x:Name="HostBox" />
            </DockPanel>
            <TextBlock x:Name="HostResult" Style="{StaticResource Result}" />
            <CheckBox x:Name="PinsConfirmed" Margin="0,10,0,0" IsEnabled="False" Checked="OnPinsConfirmed" Unchecked="OnPinsConfirmed">
                <TextBlock x:Name="PinsConfirmedText" TextWrapping="Wrap" />
            </CheckBox>

            <TextBlock x:Name="AccessHeading" Style="{StaticResource Heading}" />
            <TextBlock x:Name="AccessHint" Style="{StaticResource Hint}" />
            <DockPanel>
                <Button x:Name="AccessCheck" DockPanel.Dock="Right" IsEnabled="False" Click="OnCheckAccess" />
                <PasswordBox x:Name="AccessTokenBox" />
            </DockPanel>
            <TextBlock x:Name="AccessResult" Style="{StaticResource Result}" />
            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                <TextBlock x:Name="TokenExpiresLabel" VerticalAlignment="Center" Width="360" TextWrapping="Wrap" />
                <DatePicker x:Name="TokenExpiresPicker" Width="160" />
            </StackPanel>

            <TextBlock x:Name="ProtectHeading" Style="{StaticResource Heading}" />
            <TextBlock x:Name="ProtectHint" Style="{StaticResource Hint}" />
            <DockPanel>
                <Button x:Name="ProtectCheck" DockPanel.Dock="Right" IsEnabled="False" Click="OnCheckProtect" />
                <PasswordBox x:Name="ProtectKeyBox" />
            </DockPanel>
            <TextBlock x:Name="ProtectResult" Style="{StaticResource Result}" />
            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                <TextBlock x:Name="ProtectKeyExpiresLabel" VerticalAlignment="Center" Width="360" TextWrapping="Wrap" />
                <DatePicker x:Name="ProtectKeyExpiresPicker" Width="160" />
            </StackPanel>
            <TextBlock x:Name="ExpiryHint" Style="{StaticResource Hint}" Margin="0,6,0,0" />

            <TextBlock x:Name="DoorsHeading" Style="{StaticResource Heading}" />
            <TextBlock x:Name="DoorsHint" Style="{StaticResource Hint}" />
            <TextBlock x:Name="DoorsPlaceholder" Foreground="#888888" />
            <Grid x:Name="DoorGrid" Margin="0,4,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="1.3*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
            </Grid>
            <TextBlock x:Name="DoorsResult" Style="{StaticResource Result}" />
            <TextBlock x:Name="StreamHint" Style="{StaticResource Hint}" Margin="0,8,0,0" Visibility="Collapsed" />

            <TextBlock x:Name="LiveViewHeading" Style="{StaticResource Heading}" />
            <CheckBox x:Name="LiveViewBox" IsChecked="True">
                <TextBlock x:Name="LiveViewText" TextWrapping="Wrap" />
            </CheckBox>
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <TextBlock x:Name="LiveViewSecondsLabel" VerticalAlignment="Center" Width="360" TextWrapping="Wrap" />
                <TextBox x:Name="LiveViewSecondsBox" Text="60" Width="70" />
            </StackPanel>

            <TextBlock x:Name="LanguageHeading" Style="{StaticResource Heading}" />
            <TextBlock x:Name="LanguageHint" Style="{StaticResource Hint}" />
            <StackPanel Orientation="Horizontal">
                <RadioButton x:Name="LanguageDe" Content="Deutsch" GroupName="Language" IsChecked="True" Margin="0,0,24,0" />
                <RadioButton x:Name="LanguageEn" Content="English" GroupName="Language" Margin="0,0,24,0" />
                <RadioButton x:Name="LanguagePl" Content="Polski" GroupName="Language" />
            </StackPanel>

            <TextBlock x:Name="SaveHeading" Style="{StaticResource Heading}" />
            <StackPanel Orientation="Horizontal">
                <Button x:Name="SaveButton" Margin="0" IsEnabled="False" Click="OnSave" />
            </StackPanel>
            <TextBlock x:Name="SaveResult" Style="{StaticResource Result}" />
            <TextBlock x:Name="SaveHint" Style="{StaticResource Hint}" Margin="0,10,0,0" />
        </StackPanel>
    </ScrollViewer>
</Window>
