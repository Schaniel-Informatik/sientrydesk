<Window x:Class="SIEntryDesk.App.SetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SI EntryDesk – Einrichtung"
        Width="900" Height="920" MinWidth="760" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI" FontSize="14">
    <Window.Resources>
        <Style x:Key="Heading" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,22,0,6" />
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#666666" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
        <Style x:Key="Result" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,8,0,0" />
            <Setter Property="FontFamily" Value="Consolas, Segoe UI" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="14,5" />
            <Setter Property="Margin" Value="8,0,0,0" />
        </Style>
    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28,12,28,28">
            <TextBlock Text="Einrichtung" FontSize="26" FontWeight="SemiBold" />
            <TextBlock Style="{StaticResource Hint}"
                       Text="Prüft die Voraussetzungen bei UniFi und erstellt die sientrydesk.json für diese Anlage, oder prüft eine bestehende. Tokens werden nur zum Prüfen verwendet und nicht gespeichert. Nur im Firmennetz oder über VPN ausführen." />
            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                <Button Content="Installierte Konfiguration laden" Margin="0" Click="OnLoadInstalled" />
                <Button Content="Andere sientrydesk.json öffnen …" Click="OnOpenConfig" />
            </StackPanel>
            <TextBlock x:Name="LoadResult" Style="{StaticResource Result}" />

            <TextBlock Style="{StaticResource Heading}" Text="1. Konsole" />
            <TextBlock Style="{StaticResource Hint}" Text="Name oder IP der UniFi-Konsole, auf der Access und Protect laufen." />
            <DockPanel>
                <Button x:Name="HostCheck" DockPanel.Dock="Right" Content="Prüfen" Click="OnCheckHost" />
                <TextBox x:Name="HostBox" />
            </DockPanel>
            <TextBlock x:Name="HostResult" Style="{StaticResource Result}" />
            <CheckBox x:Name="PinsConfirmed" Margin="0,10,0,0" IsEnabled="False" Checked="OnPinsConfirmed" Unchecked="OnPinsConfirmed">
                <TextBlock TextWrapping="Wrap"
                           Text="Diese Verbindung geht sicher zur richtigen Konsole (Firmennetz oder VPN). Die Fingerabdrücke als Pins übernehmen." />
            </CheckBox>

            <TextBlock Style="{StaticResource Heading}" Text="2. Access-Token" />
            <TextBlock Style="{StaticResource Hint}"
                       Text="Access → Einstellungen → Allgemein → API Token. Benötigt: Gerät = Anzeigen, Standorte = Bearbeiten, alles andere Keinen. Geprüft wird rein lesend, das Recht zum Öffnen an einer Tür, die es nicht gibt." />
            <DockPanel>
                <Button x:Name="AccessCheck" DockPanel.Dock="Right" Content="Prüfen" IsEnabled="False" Click="OnCheckAccess" />
                <PasswordBox x:Name="AccessTokenBox" />
            </DockPanel>
            <TextBlock x:Name="AccessResult" Style="{StaticResource Result}" />
            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                <TextBlock Text="Gültig bis (wie in Access beim Anlegen angezeigt):" VerticalAlignment="Center" Width="360" />
                <DatePicker x:Name="TokenExpiresPicker" Width="160" />
            </StackPanel>

            <TextBlock Style="{StaticResource Heading}" Text="3. Protect-Schlüssel (für das Livebild)" />
            <TextBlock Style="{StaticResource Hint}"
                       Text="UniFi OS → Einstellungen → Control Plane → Integrations. Der Schlüssel hat die Protect-Rechte des Kontos, unter dem er angelegt wurde." />
            <DockPanel>
                <Button x:Name="ProtectCheck" DockPanel.Dock="Right" Content="Prüfen" IsEnabled="False" Click="OnCheckProtect" />
                <PasswordBox x:Name="ProtectKeyBox" />
            </DockPanel>
            <TextBlock x:Name="ProtectResult" Style="{StaticResource Result}" />
            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                <TextBlock Text="Gültig bis (wie in UniFi OS beim Anlegen angezeigt):" VerticalAlignment="Center" Width="360" />
                <DatePicker x:Name="ProtectKeyExpiresPicker" Width="160" />
            </StackPanel>
            <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,0"
                       Text="Das Ablaufdatum geben die Schnittstellen nicht preis, es steht nur in der UniFi-Oberfläche. Ab 14 Tagen vor dem früheren der beiden Daten wird das Symbol orange, und jede App meldet einmal pro Tag, bis wann erneuert werden muss." />

            <TextBlock Style="{StaticResource Heading}" Text="4. Türen und Kameras" />
            <TextBlock Style="{StaticResource Hint}"
                       Text="Zu jeder Tür die Kamera ihrer Türstation. Der Vorschlag kommt aus den Namen. Angehakte Türen erscheinen auf den PCs, alle angehakt = alle Türen." />
            <TextBlock x:Name="DoorsPlaceholder" Foreground="#888888" Text="Erscheint nach der Prüfung von Access-Token und Protect-Schlüssel." />
            <Grid x:Name="DoorGrid" Margin="0,4,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="1.3*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
            </Grid>
            <TextBlock x:Name="DoorsResult" Style="{StaticResource Result}" />
            <TextBlock x:Name="StreamHint" Style="{StaticResource Hint}" Margin="0,8,0,0" Visibility="Collapsed"
                       Text="Ohne Stream kein Livebild. Anlegen mit „Stream anlegen“ oder in Protect bei der Kamera unter Einstellungen → Erweitert → RTSP, Qualität „Mittel“. Die Stream-Adresse wirkt wie ein Zugangsschlüssel, nicht weitergeben." />

            <TextBlock Style="{StaticResource Heading}" Text="5. Livebild ohne Klingeln" />
            <CheckBox x:Name="LiveViewBox" IsChecked="True">
                <TextBlock TextWrapping="Wrap"
                           Text="Benutzer dürfen das Livebild jederzeit öffnen, auch wenn niemand klingelt (Linksklick auf das Klingel-Symbol, dann die Tür). Jeder Abruf wird mit Benutzer protokolliert." />
            </CheckBox>
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <TextBlock Text="Das Livebild schliesst sich nach (15–600 Sekunden):" VerticalAlignment="Center" Width="360" />
                <TextBox x:Name="LiveViewSecondsBox" Text="60" Width="70" />
            </StackPanel>

            <TextBlock Style="{StaticResource Heading}" Text="6. Speichern" />
            <StackPanel Orientation="Horizontal">
                <Button x:Name="SaveButton" Content="sientrydesk.json speichern …" Margin="0" IsEnabled="False" Click="OnSave" />
            </StackPanel>
            <TextBlock x:Name="SaveResult" Style="{StaticResource Result}" />
            <TextBlock Style="{StaticResource Hint}" Margin="0,10,0,0"
                       Text="Danach: sientrydesk.json neben install.ps1 legen. Von Hand installieren mit install.ps1 -SetTokens. Per Intune das Programmpaket mit der sientrydesk.json und die Zugänge als eigenes Paket (SIEntryDesk-Zugaenge), siehe docs/intune.md." />
        </StackPanel>
    </ScrollViewer>
</Window>
