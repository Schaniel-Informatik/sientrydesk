<Window x:Class="SIEntryDesk.App.CheckWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SI EntryDesk – Prüfung"
        Width="760" Height="720" MinWidth="560" MinHeight="420"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI" FontSize="14">
    <DockPanel Margin="24,16,24,20">
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="Prüfung" FontSize="26" FontWeight="SemiBold" />
            <TextBlock Foreground="#666666" TextWrapping="Wrap" Margin="0,4,0,10"
                       Text="Prüft diesen PC und die Verbindung zur Anlage mit den hier gespeicherten Zugängen. Das Ergebnis enthält keine Geheimnisse und kann für die Fehlersuche weitergegeben werden." />
            <TextBlock x:Name="Summary" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,8" />
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button x:Name="RunButton" Content="Erneut prüfen" Padding="14,5" Margin="0,0,8,0" Click="OnRun" />
            <Button x:Name="CopyButton" Content="Ergebnis kopieren" Padding="14,5" Margin="0,0,8,0" IsEnabled="False" Click="OnCopy" />
            <Button Content="Schliessen" Padding="14,5" Click="OnClose" />
        </StackPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="Results" />
        </ScrollViewer>
    </DockPanel>
</Window>
