<Window x:Class="SIEntryDesk.App.CheckWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SI EntryDesk"
        Width="760" Height="720" MinWidth="560" MinHeight="420"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI" FontSize="14">
    <DockPanel Margin="24,16,24,20">
        <StackPanel DockPanel.Dock="Top">
            <!-- Texts are set in the code, in the admin language. -->
            <TextBlock x:Name="Heading" FontSize="26" FontWeight="SemiBold" />
            <TextBlock x:Name="Intro" Foreground="#666666" TextWrapping="Wrap" Margin="0,4,0,10" />
            <TextBlock x:Name="Summary" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,8" />
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button x:Name="RunButton" Padding="14,5" Margin="0,0,8,0" Click="OnRun" />
            <Button x:Name="CopyButton" Padding="14,5" Margin="0,0,8,0" IsEnabled="False" Click="OnCopy" />
            <Button x:Name="CloseButton" Padding="14,5" Click="OnClose" />
        </StackPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="Results" />
        </ScrollViewer>
    </DockPanel>
</Window>
