// SI EntryDesk: installation configuration. Put it as sientrydesk.json next to install.ps1.
// No secrets: tokens and keys come via set-tokens.ps1 or install.ps1 -SetTokens.
// Comments only on lines of their own.
{
  // Language for the users: "de", "en" or "pl". Check and log: German for "de", otherwise English.
  "Language": "de",

  // Address of the UniFi console (name or IP)
  "Host": "unifi.example.local",

  // Certificate fingerprints, show them with: SIEntryDesk.Service.exe show-pins <host>
  "AccessPin": "00:11:22:33:44:55:66:77:88:99:AA:BB:CC:DD:EE:FF:00:11:22:33:44:55:66:77:88:99:AA:BB:CC:DD:EE:FF",
  "ProtectPin": "00:11:22:33:44:55:66:77:88:99:AA:BB:CC:DD:EE:FF:00:11:22:33:44:55:66:77:88:99:AA:BB:CC:DD:EE:FF",

  // Doors that are shown (door ID or name from Access). Empty = all.
  "Doors": [],

  // Door ID (Access) → camera ID of the door station (Protect). Without an entry the service learns it at the first ring.
  "DoorCameras": {
    "00000000-0000-4000-8000-000000000001": "000000000000000000000001"
  },

  // Live view without ringing in the tray menu and how long it stays open (15–600 s)
  "LiveView": true,
  "LiveViewSeconds": 60,

  // Expiry dates of the keys. From 14 days before: icon orange and a notice once a day
  "TokenExpires": "2027-09-30",
  "ProtectKeyExpires": "2027-09-30"
}
