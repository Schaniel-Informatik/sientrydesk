# Vorlage. Kopieren nach sied.env (wird nicht eingecheckt) und die Platzhalter ersetzen.
# Geheime Werte nur als 1Password-Referenz, `op run` setzt sie beim Aufruf ein.

SIED_HOST=op://<Tresor>/<Eintrag>/host
SIED_ACCESS_TOKEN=op://<Tresor>/<Eintrag>/access_token
SIED_PROTECT_KEY=op://<Tresor>/<Eintrag>/protect_key

# SHA-256-Fingerprints der Konsole, Ausgabe von `sied.py cert`. Keine Geheimnisse, aber Pflicht.
SIED_PIN_PROTECT=
SIED_PIN_ACCESS=
SIED_PIN_RTSPS=
